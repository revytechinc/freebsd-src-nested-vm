# Common shell helpers for tests/sys/vmm/nested/*.sh.
#
# shellcheck shell=sh
# FreeBSD /bin/sh supports `local` even though POSIX leaves it undefined.
# shellcheck disable=SC3043
#
# Source this file from a test body with:
#
#	. $(atf_get_srcdir)/nested_utils.subr
#

# nested_load_vmm
#
# Ensure the vmm(4) kernel module is loaded.  Tolerates "already loaded".
# Returns 0 when vmm is loaded afterwards, 1 otherwise.
nested_load_vmm()
{
	if kldstat -q -m vmm; then
		return 0
	fi
	kldload vmm 2>/dev/null || kldstat -q -m vmm
}

# nested_sysctl_get <name>
#
# Print the value of hw.vmm.nested.<name>.  Returns non-zero if the sysctl
# is not present (e.g. when nested virtualization is not yet wired up).
nested_sysctl_get()
{
	local name="$1"
	sysctl -n "hw.vmm.nested.${name}" 2>/dev/null
}

# nested_has_vmx
#
# Return 0 if Intel VMX is available on this host, non-zero otherwise.
# Reads hw.vmm.vmx.cap; non-zero means VMX is exposed.
nested_has_vmx()
{
	local cap
	cap=$(sysctl -n hw.vmm.vmx.cap 2>/dev/null) || return 1
	[ "${cap}" -gt 0 ] 2>/dev/null
}

# nested_has_svm
#
# Return 0 if AMD SVM is available on this host, non-zero otherwise.
# Reads hw.vmm.svm.features; non-zero means SVM is exposed.
nested_has_svm()
{
	local feat
	feat=$(sysctl -n hw.vmm.svm.features 2>/dev/null) || return 1
	[ "${feat}" -gt 0 ] 2>/dev/null
}

# nested_vm_create <name>
#
# Create bhyve VM <name> via bhyvectl(8) if it does not already exist.
# Existence is detected via the /dev/vmm/<name> device node.
nested_vm_create()
{
	local name="$1"
	[ -e "/dev/vmm/${name}" ] || bhyvectl --vm="${name}" --create
}