# Shared helpers for the T52a / T52b nested-virtualization hardware-layer
# test scripts. Provides:
#   nested_load_vmm     - load vmm.ko if not already resident
#   nested_vm_create    - create a bhyve VM via bhyvectl
#   nested_vm_destroy   - destroy a previously created VM
#   nested_vm_running   - check if a named VM exists in /dev/vmm
#   nested_require_root - atf_check root precondition guard
#   nested_fixture_dir  - echo the fixture directory path
#   nested_supported    - gate driver: skip on non-FreeBSD / no vmm
#
# All helpers are POSIX sh and shellcheck clean. The helpers are
# stubs on platforms where /dev/vmm is absent; the test bodies
# assert device round-trip semantics, the helpers only orchestrate
# kernel/module lifecycle.

# nested_fixture_dir echoes the absolute path to the directory where
# the nested-virt test fixtures (mfsBSD, OVMF, Alpine, kernel images)
# live. Defaults to the Kyua-installed location under /usr/tests.
nested_fixture_dir()
{
	echo "${NESTED_FIXTURE_DIR:-/usr/tests/sys/vmm/nested/fixtures}"
}

# nested_require_l2_image skips the calling test unless a bootable L2 guest
# image is present, and sets ${l2img} to its path when it is.
#
# CALL IT DIRECTLY. NOT IN A COMMAND SUBSTITUTION.
#
#	nested_require_l2_image		# correct: skip reaches the test
#	l2img=$(nested_require_l2_image)	# WRONG: skip dies in the subshell
#
# It sets a variable instead of echoing precisely so that it cannot be used
# the second way. The first version did echo the path, every caller wrote
# `l2img=$(nested_require_l2_image)', and atf_skip then exited only the
# command-substitution subshell -- so the test continued with l2img empty and
# ran `bhyve ... -s 4,virtio-blk, ...', failing on "Could not open backing
# file" instead of skipping. A guard that runs in a subshell cannot stop the
# thing it guards.
#
# WHY THIS EXISTS. Every test under hw/ launched bhyve like this:
#
#	bhyve -c 1 -m 256M -s 0,hostbridge -s 1,lpc -l com1,stdio -H -A -P <vm>
#
# There is no bootrom and no disk in that command. The guest has nothing to
# execute, so it triple-faults immediately and bhyve exits 3 -- and the test
# asserted exit 0. None of them could ever have passed, on any host, with any
# hypervisor. It went unnoticed because the directories were unreachable from
# any Kyuafile, so the tests had never been run at all.
#
# The image is deliberately NOT shipped in the package: it is a large binary
# artifact built by scripts/build_l2_image.sh (see README.artifacts.md). So
# its absence is the normal state, and it is a reason not to run rather than a
# failure. The skip names the gap so it reads as unfinished work rather than
# as a hypervisor fault.
# nested_boot_guest <logfile> <bhyve args...>
#
# Boots an L2 guest, waits only until it proves it booted, stops it, and fails
# the test if it never did.
#
# WHY A HELPER AND NOT atf_check. These tests used
#
#	atf_check -s exit:0 ... bhyve ... -P "${vmname}" </dev/null
#
# which is wrong twice. bhyve runs a guest until something stops it, so with a
# disk and firmware actually attached the guest boots and keeps running, and
# atf_check waits for a process that is not going to exit -- measured: 300
# seconds, then "broken: Test case body timed out", per test. And `-s exit:0'
# is not the right assertion anyway: bhyve exits 0 on reset, 1 on poweroff, 2
# on halt and 3 on a triple fault, so the status says how the guest STOPPED,
# not whether it ever ran.
#
# What is asserted instead is boot output. Measured on freedev010 against the
# mfsBSD fixture: the console carries "BdsDxe" from the UEFI firmware and then
# "FreeBSD 16.0-CURRENT" from the kernel, about 10 KB in all. A triple fault
# produces none of it, which is the case this has to catch.
#
# The wait stops as soon as the banner appears rather than burning the whole
# timeout, because 21 tests times a fixed wait is the difference between a
# suite you run and one you do not.
nested_boot_guest()
{
	local log="$1"
	shift
	local waited=0
	local limit="${NESTED_BOOT_TIMEOUT:-90}"
	local bpid

	: > "${log}"
	bhyve "$@" > "${log}" 2>&1 </dev/null &
	bpid=$!

	while [ "${waited}" -lt "${limit}" ]; do
		if grep -aq 'FreeBSD' "${log}" 2>/dev/null; then
			break
		fi
		kill -0 "${bpid}" 2>/dev/null || break
		sleep 1
		waited=$((waited + 1))
	done

	# bhyve ignores SIGTERM, so ask, wait, then insist. A bare kill here
	# leaves the guest running and the next test unable to allocate.
	kill "${bpid}" 2>/dev/null || true
	local killwait=0
	while [ "${killwait}" -lt 10 ] && kill -0 "${bpid}" 2>/dev/null; do
		sleep 1
		killwait=$((killwait + 1))
	done
	if kill -0 "${bpid}" 2>/dev/null; then
		kill -9 "${bpid}" 2>/dev/null || true
	fi
	wait "${bpid}" 2>/dev/null || true

	if ! grep -aq 'FreeBSD' "${log}" 2>/dev/null; then
		atf_fail "the L2 guest produced no FreeBSD boot banner in ${limit}s -- see ${log}"
	fi
}

# nested_require_bootrom skips the calling test unless bhyve's UEFI firmware
# is installed, and sets ${bootrom} to its path when it is.
#
# The L2 image is a GPT/UEFI disk, so a disk alone is not enough: without
# firmware there is nothing to execute at reset and the guest triple-faults
# exactly as it did with no disk at all -- bhyve exits 3 either way, which is
# why attaching the image changed 21 skips into 21 identical failures and no
# new information.
#
# Same calling convention as nested_require_l2_image: call it DIRECTLY, never
# in a command substitution, or the skip dies in the subshell.
nested_require_bootrom()
{
	# Deliberately not local: the caller uses ${bootrom} after this returns.
	bootrom="${NESTED_BOOTROM:-/usr/local/share/uefi-firmware/BHYVE_UEFI.fd}"

	if [ ! -f "${bootrom}" ]; then
		atf_skip "no UEFI firmware at ${bootrom} -- pkg install bhyve-firmware, or set NESTED_BOOTROM"
	fi
}

nested_require_l2_image()
{
	# Deliberately NOT local: the caller uses ${l2img} after this returns.
	l2img="${NESTED_L2_IMAGE:-$(nested_fixture_dir)/l2_freebsd.img}"

	if [ ! -f "${l2img}" ]; then
		atf_skip "no L2 guest image at ${l2img} -- build one with scripts/build_l2_image.sh, or set NESTED_L2_IMAGE"
	fi
}

# nested_supported returns success (0) when the host can actually
# run nested-virt tests: vmm(4) must be loadable and either VMX or
# SVM must be present in CPUID. Returns 1 otherwise; callers should
# invoke `atf_skip "..."` when this helper fails.
nested_supported()
{
	if [ "${NESTED_TEST_DRIVER:-auto}" = "force-run" ]; then
		return 0
	fi
	if ! [ -r /dev/vmm ] && ! kldstat 2>/dev/null | grep -qw vmm; then
		# Try to load vmm(4) - typical CI path.
		if command -v kldload >/dev/null 2>&1; then
			kldload vmm 2>/dev/null || true
		fi
	fi
	if ! [ -r /dev/vmm ] && ! kldstat 2>/dev/null | grep -qw vmm; then
		return 1
	fi
	if ! sysctl -n hw.vmm.vmx.cap >/dev/null 2>&1 && \
	    ! grep -qw svm /proc/cpuinfo 2>/dev/null; then
		return 1
	fi
	return 0
}

# nested_load_vmm ensures the vmm(4) module is loaded. Idempotent.
# Usage: nested_load_vmm
# Returns: 0 on success, 1 if vmm could not be loaded.
nested_load_vmm()
{
	if kldstat 2>/dev/null | grep -qw vmm; then
		return 0
	fi
	if [ -r /dev/vmm ]; then
		return 0
	fi
	if command -v kldload >/dev/null 2>&1; then
		kldload vmm 2>/dev/null && return 0
	fi
	return 1
}

# EVERYTHING HERE IS A SHELL FUNCTION. CALL IT DIRECTLY.
#
# These are functions in the sourcing shell, not programs on PATH, so they
# cannot be handed to atf_check and they are not visible to `sh -c'. Both
# spawn a process that never sourced this file:
#
#	atf_check ... nested_vm_create "$vm" 256M	-> execvp: No such file
#	atf_check ... sh -c "nested_vm_running $vm"	-> command not found
#
# Every test under hw/ did one of those, and each failed in about twenty
# milliseconds with exit 127 -- long before it could reach a hypervisor. They
# were written that way and never run, because the directories holding them
# were listed under SUBDIR rather than TESTS_SUBDIRS and so were absent from
# the generated Kyuafile. Twenty-three tests that could never have passed sat
# in the tree looking like coverage.
#
# The shape that works, and what they use now:
#
#	nested_vm_create "$vm" 256M >"$logdir/create.log" 2>&1 ||
#	    atf_fail "nested_vm_create $vm failed -- see $logdir/create.log"
#
# atf_check is still right for real commands -- bhyve, bhyvectl, sysctl.
# It is only wrong for the helpers in this file.

# nested_vm_create creates a bhyve VM with the given name. The
# optional second argument is a memory size (default 256M). Returns
# 0 if the VM was created, non-zero if bhyvectl failed.
# Usage: nested_vm_create <vmname> [memsize]
nested_vm_create()
{
	local vmname="$1"
	local memsize="${2:-256M}"

	if [ -z "${vmname}" ]; then
		echo "nested_vm_create: empty vm name" >&2
		return 2
	fi

	# A VM left behind by an earlier run holds its memory allocation, and
	# creating over it fails. Clear a stale one first so a single leak does
	# not block every subsequent run -- the top-level nested_utils.subr has
	# always done this and this copy had drifted away from it.
	if [ -e "/dev/vmm/${vmname}" ]; then
		bhyvectl --vm="${vmname}" --destroy >/dev/null 2>&1 || true
	fi

	# NOT 2>/dev/null. bhyvectl's message is the only thing that says WHY a
	# create failed, and discarding it is how a caller ends up with an empty
	# create.log and a failure it cannot explain. Measured: with sixteen
	# leaked VMs on the host every create failed with "vm_open: ... Cannot
	# allocate memory", and not one of those words reached the log.
	bhyvectl --vm="${vmname}" --create || return 1
	# Set memory; ignore failure (older bhyvectl may not support it).
	bhyvectl --vm="${vmname}" --memsize="${memsize}" 2>/dev/null || true
	return 0
}

# nested_vm_destroy tears down a previously created VM. Always
# invoked from the `_cleanup` function. Returns 0 even when the VM
# did not exist; non-zero only on unexpected bhyvectl errors.
# Usage: nested_vm_destroy <vmname>
nested_vm_destroy()
{
	local vmname="$1"

	if [ -z "${vmname}" ]; then
		return 0
	fi
	bhyvectl --vm="${vmname}" --destroy 2>/dev/null || true
	# Some hosts keep the /dev/vmm/<name> node after --destroy;
	# attempt best-effort removal. The node is owned by devfs.
	return 0
}

# nested_vm_running returns 0 if the named VM appears in the vmm(4)
# instance list. The check is best-effort and does not require vmmctl.
# Usage: nested_vm_running <vmname>
nested_vm_running()
{
	local vmname="$1"

	if [ -z "${vmname}" ]; then
		return 1
	fi
	# /dev/vmm/<name> is the canonical node created by bhyvectl.
	if [ -e "/dev/vmm/${vmname}" ]; then
		return 0
	fi
	return 1
}

# nested_require_root is a convenience wrapper around atf_check that
# asserts the test is running as root. Use as the first assertion
# in any _body function that needs /dev/vmm access.
# Usage: nested_require_root
nested_require_root()
{
	atf_check -s exit:0 -o ignore -e ignore \
	    sh -c '[ "$(id -u)" = "0" ]'
}

# nested_log_dir echoes a per-test log directory under /tmp that the
# body function can write diagnostic output to. The runner script
# captures whatever lands here for post-mortem analysis.
# Usage: nested_log_dir <testname>
nested_log_dir()
{
	local testname="$1"
	local base="${NESTED_LOG_DIR:-/tmp/nested-hw-logs}"

	echo "${base}/${testname}.$$"
}

# nested_make_log_dir creates the per-test log directory and echoes
# its path. Safe to call from _body.
# Usage: nested_make_log_dir <testname>
nested_make_log_dir()
{
	local testname="$1"
	local dir

	dir=$(nested_log_dir "${testname}")
	mkdir -p "${dir}" 2>/dev/null || true
	echo "${dir}"
}

# nested_default_vmname returns a stable per-script VM name suitable
# for bhyvectl. Uses NESTED_VM_PREFIX so concurrent tests don't
# collide on /dev/vmm/<name>.
# Usage: nested_default_vmname <script>
nested_default_vmname()
{
	local script="$1"
	local prefix="${NESTED_VM_PREFIX:-nested}"

	# NO $$ HERE. It used to end "-$$", and that leaked every VM the hw
	# tests ever created.
	#
	# atf runs a test case's body and its cleanup routine as SEPARATE
	# PROCESSES. Both call this function to work out which VM to act on, so
	# with the pid in the name the cleanup computed a name that had never
	# existed, destroyed nothing, and reported success. Measured on
	# freedev010: one suite run left sixteen VMs registered in /dev/vmm with
	# no bhyve process behind any of them, and once they had eaten the
	# available allocation every later create failed with "Cannot allocate
	# memory" -- which reads like a host or hypervisor fault and is neither.
	#
	# A name derived only from the test case is the same in both processes,
	# which is the whole requirement. It also means a leaked VM is named
	# after the test that leaked it, and nested_vm_create clears a stale one
	# rather than failing behind it.
	echo "${prefix}-${script}"
}
